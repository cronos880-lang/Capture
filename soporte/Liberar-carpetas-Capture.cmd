@echo off
setlocal
cd /d "%TEMP%"
"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile -Command "$ErrorActionPreference = 'Stop'; try { $session = [Diagnostics.Process]::GetCurrentProcess().SessionId; $file = '(?i)(?:^|\s)-File\s+(?:\x22([^\x22]+)\x22|(\S+))\s*$'; $old = '(?i)\\Capture-(?:atajo-y-linea|recorte-y-trazos)\\src\\Capture\.ps1$'; $closed = 0; foreach ($entry in (Get-CimInstance Win32_Process -Filter ('Name = ''powershell.exe'' AND SessionId = ' + $session))) { if ($entry.CommandLine -notmatch $file) { continue }; $path = $Matches[1]; if (!$path) { $path = $Matches[2] }; if ($path -notmatch $old) { continue }; $process = Get-Process -Id $entry.ProcessId -ErrorAction SilentlyContinue; if (!$process -or $process.ProcessName -ne 'powershell') { continue }; try { if ([Math]::Abs(($process.StartTime - $entry.CreationDate).TotalSeconds) -ge 1) { continue }; $process.Kill(); if (!$process.WaitForExit(5000)) { throw 'El proceso no ha terminado.' }; $closed++; Write-Host ('Cerrado: ' + (Split-Path (Split-Path $path -Parent) -Parent)) } finally { $process.Dispose() } }; if ($closed -eq 0) { Write-Host 'No hay procesos abiertos de esas dos versiones en esta sesion.' } else { Write-Host 'Ya puedes volver a intentar borrar las carpetas desde el Explorador.' } } catch { Write-Host ('No se pudo completar el cierre: ' + $_.Exception.Message); exit 1 }"
echo.
pause
